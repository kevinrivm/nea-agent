# =============================================================================
# Nea — agente de agendamiento para WhatsApp · variables de entorno
# Copia este archivo a `.env` y reemplaza los REEMPLAZA_...
# En Coolify, estas mismas variables van en el runtime del contenedor.
# =============================================================================

# --- Webhook de Meta ---------------------------------------------------------

# Token que TÚ inventas y pegas igual en la configuración del webhook de la app
# de Meta (developers.facebook.com → WhatsApp → Configuration → Verify token).
VERIFY_TOKEN=REEMPLAZA_token_secreto_de_verificacion

# App Secret de la app de Meta (Settings → Basic → App Secret). Si tiene valor,
# se verifica la firma x-hub-signature-256 de cada POST (inválida → 401).
# Opcional: déjalo vacío solo en desarrollo local.
META_APP_SECRET=

# --- CRM (vocero-crm, bot gateway /api/bot/*) --------------------------------

# URL base del CRM (sin / final). Ej: https://crm.tu-negocio.com
CRM_BASE_URL=REEMPLAZA_https://tu-crm

# URL COMPLETA del webhook del CRM, incluyendo el segmento del verify token
# del CRM. El bot le releva el payload crudo de Meta con la firma intacta.
# Ej: https://crm.tu-negocio.com/api/webhooks/wa/EL_VERIFY_TOKEN_DEL_CRM
CRM_WEBHOOK_URL=REEMPLAZA_https://tu-crm/api/webhooks/wa/token

# API key de servicio del CRM (BOT_API_KEY en el .env del CRM; genera con
# `openssl rand -hex 32`). Va en el header X-API-Key de cada llamada /api/bot/*.
CRM_BOT_API_KEY=REEMPLAZA_api_key_de_32_bytes

# --- Perfil del negocio ------------------------------------------------------

# Nombre del agente si el CRM no define uno (el agent profile de Vocero manda).
AGENT_NAME=Nea

# Zona horaria IANA para las fechas que ve el LLM.
AGENT_TIMEZONE=America/Mexico_City

# Markdown local con el brief del negocio (ver examples/brief.example.md).
# Fallback: solo se usa si el CRM no expone /api/bot/profile o está caído.
BRIEF_PATH=

# --- LLM (OpenAI) ------------------------------------------------------------

# API key de OpenAI (platform.openai.com → API keys).
# Los nombres viejos (OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL,
# OPENAI_TRANSCRIBE_MODEL) SIGUEN funcionando: si ya tienes Nea corriendo, no
# tienes que tocar nada. Se renombraron porque el proveedor no tiene por qué
# ser OpenAI, y llamarlas OPENAI_* apuntando a OpenRouter es decir una cosa y
# hacer otra.
LLM_API_KEY=REEMPLAZA_sk-...

# Modelo para las respuestas en vivo. Usa un modelo RÁPIDO, no "razonador"
# (gotcha del selftest: los razonadores tardan y devuelven content vacío).
LLM_MODEL=gpt-4o-mini

# Proveedor del modelo. Vacío = OpenAI, como siempre.
#
# Sirve cualquier API compatible con OpenAI. Para OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=z-ai/glm-5.3-flash   (el modelo lleva su prefijo)
#
LLM_BASE_URL=

# Modelo que TRANSCRIBE las notas de voz. Con OpenAI, whisper-1.
#
# Con otro proveedor no hay endpoint de transcripción: el audio viaja dentro
# del chat, así que aquí va un modelo que ACEPTE AUDIO. No tiene por qué ser el
# mismo que conversa — hoy los GLM, por ejemplo, no oyen. Uno conversa y otro
# escucha, con la misma clave:
#
#   LLM_MODEL=z-ai/glm-5.3-flash                 (conversa)
#   LLM_TRANSCRIBE_MODEL=google/gemini-2.5-flash (escucha)
#
# Dejar whisper-1 con otro proveedor hace fallar TODA nota de voz. Nea lo avisa
# al arrancar en vez de dejar que lo descubras con un cliente esperando.
LLM_TRANSCRIBE_MODEL=whisper-1

# Cuántos mensajes recientes del historial se le pasan al LLM por turno.
HISTORY_WINDOW=10

# --- Guardarraíles y tiempos -------------------------------------------------

# Allowlist de pruebas: CSV de identidades de WhatsApp (teléfonos con lada,
# ej 5215512345678, o BSUIDs). Con valor, el bot SOLO responde a esas
# identidades (el resto se releva al CRM sin respuesta). Vacíala SOLO para
# salir a producción — decisión explícita del dueño.
ALLOWED_WA_IDS=REEMPLAZA_5215512345678

# Quien puede usar el comando /reset (borra la memoria de SU conversacion).
# Va aparte de ALLOWED_WA_IDS a proposito: en produccion esa lista va vacia
# para atender a todos los leads, y colgar el /reset de ella dejaba el
# comando muerto justo donde hace falta para una ronda de pruebas en vivo.
# Vacia = comando apagado. CSV de identidades, misma forma que arriba.
TESTER_WA_IDS=

# Segundos de coalescencia: una ráfaga de mensajitos = UNA respuesta.
COALESCE_SECONDS=4

# Segundos entre recibir un mensaje y mostrar "escribiendo…" (antes del coalesce).
TYPING_DELAY_SECONDS=0.5

# Horas de silencio del lead antes del ÚNICO empujón de seguimiento.
FOLLOWUP_HOURS=4

# --- Infra -------------------------------------------------------------------

# Postgres PROPIO del bot (no el del CRM). Las migraciones corren al arranque.
# Ej: postgresql://nea:password@localhost:5432/nea
DATABASE_URL=REEMPLAZA_postgresql://usuario:password@host:5432/nea

# Puerto del servidor (healthcheck: GET /health).
PORT=8000

# Desarrollo: loguear el JSON crudo de mensajes no-texto para capturar
# formatos reales de Meta. Apagar en producción.
CAPTURE_PAYLOADS=false

# --- Harness de pruebas en vivo (opcional; SOLO local, jamás en producción) --
# Evolution API que controla una línea tester TUYA para conversar con el bot
# en el canal real (selftest/evolution.py: pausas mínimas, tope de mensajes,
# kill-switch de archivo STOP_LIVE_RUN).
EVOLUTION_BASE_URL=REEMPLAZA_https://tu-evolution.example.com
EVOLUTION_INSTANCE=REEMPLAZA_instancia
EVOLUTION_APIKEY=REEMPLAZA_apikey
# Número al que escribe el tester (único destino permitido)
LIVE_TARGET_NUMBER=REEMPLAZA_52XXXXXXXXXX

# --- Modo cloud: Nea detrás de un Vocero multitenant (opcional) --------------
#
# Vacío = comportamiento de SIEMPRE. Meta manda el webhook a Nea, Nea lo relaya
# al CRM y habla con /api/bot/*. Si tienes Nea funcionando, NO toques nada de
# aquí abajo: sin VOCERO_MODE nada de esto se activa.
#
# "cloud" = Nea vive detrás de un Vocero multitenant. Cambian tres cosas:
#   - El CRM recibe el mensaje y se lo DESPACHA a Nea firmado
#     (POST /vocero/dispatch), en vez de que Meta le pegue a Nea.
#   - Nea contesta por /api/brains/* con el secreto de la organización.
#   - No hay relay: el CRM ya tiene el mensaje, reenviárselo lo duplicaría.
# En este modo NO hacen falta META_APP_SECRET, VERIFY_TOKEN ni CRM_WEBHOOK_URL:
# Nea deja de hablar con Meta directamente.
VOCERO_MODE=

# El secreto. De dónde sale depende de cuántos negocios atienda esta Nea:
#
#   UN negocio  → Ajustes → Cerebro del CRM, opción «mi propio agente».
#   VARIOS      → del despliegue, que registra el dueño de la plataforma con
#                 `pnpm cerebro:registrar` en el CRM. Ningún miembro lo ve.
#
# Firma lo que llega Y autentica lo que sale: el mismo en las dos direcciones.
CRM_BRAIN_SECRET=

# El slug de la organización ({slug}.tudominio.com).
#
# **VACÍO = MULTI-ORGANIZACIÓN.** Esta Nea deja de servir a un negocio y sirve
# a todos los que el CRM le suscriba: cada despacho dice de quién es, y la
# credencial para contestar se deriva del secreto de arriba. Es lo que evita
# levantar un contenedor por miembro.
#
# En ese modo cada negocio pone SU llave de OpenRouter en su propio CRM y Nea
# la recibe con el contexto de cada conversación: LLM_API_KEY de abajo NO se
# usa, y si el CRM no la entrega, Nea se calla y deja la conversación a un
# humano en vez de cobrarle a tu cuenta el consumo de todos.
#
# Con un slug puesto, el CRM verifica que el secreto y el slug correspondan,
# así que acertar uno sin el otro no sirve.
CRM_ORGANIZATION=
