# =============================================================================
# Nea — agente de agendamiento (WhatsApp, Instagram, Messenger, TikTok)
# Copia este archivo a `.env` y reemplaza los REEMPLAZA_...
# En Coolify, estas mismas variables van en el runtime del contenedor.
# =============================================================================

# --- CRM (vocero-crm) ---------------------------------------------------------
#
# Desde la 2.0, Nea NO recibe el webhook de Meta: lo recibe el CRM, que guarda
# el mensaje y se lo DESPACHA a Nea firmado (POST /vocero/dispatch). En el CRM:
#   BRAIN_DISPATCH_URL=https://tu-nea/vocero/dispatch
#   BOT_API_KEY=<la misma llave que CRM_BOT_API_KEY de aquí abajo>
# Por eso aquí ya no van META_APP_SECRET, VERIFY_TOKEN ni CRM_WEBHOOK_URL. Si
# vienes de la 1.x y las tienes puestas, Nea avisa al arrancar: se pueden quitar.

# URL base del CRM (sin / final). Ej: https://crm.tu-negocio.com
CRM_BASE_URL=REEMPLAZA_https://tu-crm

# API key de servicio del CRM (BOT_API_KEY en el .env del CRM; genera con
# `openssl rand -hex 32`). Va en el header X-API-Key de cada llamada /api/bot/*
# Y es con la que el CRM firma cada despacho: la misma en las dos direcciones.
CRM_BOT_API_KEY=REEMPLAZA_api_key_de_32_bytes

# --- Perfil del negocio ------------------------------------------------------

# Nombre del agente si el CRM no define uno (el agent profile de Vocero manda).
AGENT_NAME=Nea

# Zona horaria IANA de respaldo para las fechas que ve el LLM. La de cada
# negocio la manda el CRM (Ajustes → Agenda) y es la que manda; esta solo se
# usa si el CRM no la dice (sin agenda).
AGENT_TIMEZONE=America/Mexico_City

# Markdown local con el brief del negocio (ver examples/brief.example.md).
# Fallback: solo se usa si el CRM no expone /api/bot/profile o está caído.
BRIEF_PATH=

# --- LLM (OpenAI) ------------------------------------------------------------

# Llave del proveedor del modelo. OPCIONAL junto a Vocero 2.0 (spec 036 de
# vocero-crm):
#
#   - VACÍA = Nea piensa por el CRM. La llave vive en Ajustes → IA del CRM y
#     no viaja hasta aquí: Nea llama a {CRM_BASE_URL}/api/bot/llm con
#     CRM_BOT_API_KEY y usa el modelo que elegiste allá (LLM_MODEL solo si el
#     CRM no dice cuál). Sin IA configurada en el CRM, Nea no contesta y le
#     pasa la conversación a una persona. /health dice `"llm": "crm"`.
#   - CON VALOR = cerebro propio: Nea usa esta llave con su proveedor
#     (LLM_BASE_URL), como siempre. /health dice `"llm": "propia"`.
#
# En modo cloud (VOCERO_MODE=cloud) esto no aplica: ver más abajo.
#
# Con llave propia de OpenAI: platform.openai.com → API keys.
# Los nombres viejos (OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL,
# OPENAI_TRANSCRIBE_MODEL) SIGUEN funcionando: si ya tienes Nea corriendo, no
# tienes que tocar nada. Se renombraron porque el proveedor no tiene por qué
# ser OpenAI, y llamarlas OPENAI_* apuntando a OpenRouter es decir una cosa y
# hacer otra.
LLM_API_KEY=

# Modelo para las respuestas en vivo. Usa un modelo RÁPIDO, no "razonador"
# (gotcha del selftest: los razonadores tardan y devuelven content vacío).
LLM_MODEL=gpt-4o-mini

# Proveedor del modelo. Vacío = OpenAI, como siempre.
#
# Sirve cualquier API compatible con OpenAI. Para OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=z-ai/glm-5.3-flash   (el modelo lleva su prefijo)
#
LLM_BASE_URL=

# Modelo que TRANSCRIBE las notas de voz. Con OpenAI, whisper-1.
#
# Con otro proveedor no hay endpoint de transcripción: el audio viaja dentro
# del chat, así que aquí va un modelo que ACEPTE AUDIO. No tiene por qué ser el
# mismo que conversa — hoy los GLM, por ejemplo, no oyen. Uno conversa y otro
# escucha, con la misma clave:
#
#   LLM_MODEL=z-ai/glm-5.3-flash                 (conversa)
#   LLM_TRANSCRIBE_MODEL=google/gemini-2.5-flash (escucha)
#
# whisper-1 solo existe en OpenAI. Si lo dejas con otro proveedor (o pensando
# por el CRM), Nea transcribe con google/gemini-3.5-flash-lite y lo dice al
# arrancar: las notas de voz ya no fallan por no haber elegido modelo.
LLM_TRANSCRIBE_MODEL=whisper-1

# Los dos ajustes de velocidad. Van fuera del contrato de OpenAI (extra_body):
# OpenRouter los entiende. Si el proveedor rechaza la llamada por uno de ellos,
# Nea deja de mandar los dos para ese modelo y reintenta sin ellos: bajar el
# tiempo de respuesta no puede costar una respuesta.
#
# Esfuerzo de razonamiento. "minimal" lo baja al mínimo: el razonamiento se
# paga en segundos que el lead pasa mirando "escribiendo…". Vacío = no se
# manda y decide el proveedor.
LLM_REASONING_EFFORT=minimal

# A qué proveedor de OpenRouter mandar cada llamada. "throughput" = al más
# rápido. Vacío = decide OpenRouter (ordena por precio).
LLM_PROVIDER_SORT=throughput

# Segundos que se espera al proveedor del modelo en CADA intento (conversar y
# transcribir notas de voz). Nea reintenta por su cuenta (3 intentos para
# conversar, 2 para transcribir, con backoff); agotados, silencio + handoff
# "error". El SDK ya no reintenta encima: antes esperaba hasta 600 s por
# petición y reintentaba dos veces más, así que un proveedor colgado dejaba al
# lead media hora mirando "escribiendo…". Mayor que 0.
LLM_TIMEOUT_SECONDS=45

# Cuántos mensajes recientes del historial se le pasan al LLM por turno.
HISTORY_WINDOW=10

# --- Guardarraíles y tiempos -------------------------------------------------

# Allowlist de pruebas: CSV de identidades de WhatsApp (teléfonos con lada,
# ej 5215512345678, o BSUIDs de quien no comparte su número: como los enseña
# el CRM, bsuid:US.1349..., o pelones). Con valor, el bot SOLO responde a esas
# identidades (el resto se releva al CRM sin respuesta). Vacíala SOLO para
# salir a producción — decisión explícita del dueño.
ALLOWED_WA_IDS=REEMPLAZA_5215512345678

# Quien puede usar el comando /reset (borra la memoria de SU conversacion).
# Va aparte de ALLOWED_WA_IDS a proposito: en produccion esa lista va vacia
# para atender a todos los leads, y colgar el /reset de ella dejaba el
# comando muerto justo donde hace falta para una ronda de pruebas en vivo.
# Vacia = comando apagado. CSV de identidades, misma forma que arriba.
TESTER_WA_IDS=

# Horas de silencio del lead antes del ÚNICO empujón de seguimiento.
FOLLOWUP_HOURS=4

# Cada cuántos segundos, como mucho, Nea le vuelve a preguntar al CRM si agenda
# (la bandera AGENDA de Vocero). Encenderla o apagarla allá llega aquí en ese
# tiempo, sin reiniciar Nea. Pregunta el primer turno que encuentra la
# respuesta vencida, con timeout corto (3 s); si el CRM no contesta, se queda
# la última respuesta. 0 = en cada turno.
AGENDA_PROBE_TTL_SECONDS=60

# Candado de cierre: cuando la conversación no va a ningún lado, Nea se despide
# con una línea cálida y deja de perseguir. Se dispara con STALL_FILLER_STREAK
# mensajes de relleno seguidos del lead ("ok", "va", "gracias", un emoji) o con
# STALL_MAX_TURNS mensajes del lead sin llegar a agendar ni a un humano. 0 apaga
# ese disparador. Tras la despedida, el relleno se contesta con silencio durante
# STALL_COOLDOWN_HOURS; un mensaje con contenido ("¿cuánto cuesta?") reabre en el
# acto y los contadores vuelven a cero. En el CRM, la ficha del contacto enseña
# «Cierre sin rumbo» con la hora mientras dura el cierre.
STALL_MAX_TURNS=14
STALL_FILLER_STREAK=3
STALL_COOLDOWN_HOURS=24

# --- Infra -------------------------------------------------------------------

# Postgres de Nea. Las migraciones corren al arranque.
# Ej: postgresql://nea:password@localhost:5432/nea
DATABASE_URL=REEMPLAZA_postgresql://usuario:password@host:5432/nea

# Esquema donde viven las tablas de Nea. Vacío = `public`, como siempre.
# Con un nombre (p. ej. `nea`), Nea lo crea si no existe y guarda ahí todo lo
# suyo: así puede usar la MISMA base del CRM (pon en DATABASE_URL la del CRM)
# sin pisarse con él, y el par no pide una segunda base.
DATABASE_SCHEMA=

# Puerto del servidor (healthcheck: GET /health). Con la imagen de Docker
# déjalo en 8000: el HEALTHCHECK del Dockerfile pregunta siempre a ese puerto,
# y con otro Docker marca el contenedor como unhealthy.
PORT=8000

# NEA_VERSION no va aquí. La versión y el commit que enseña /health los hornea
# la imagen al construirse (build args NEA_VERSION y SOURCE_COMMIT, ver el
# Dockerfile), y una NEA_VERSION en el entorno pisaría la de la imagen. Si la
# plataforma pone SOURCE_COMMIT en el entorno, /health lo usa solo cuando la
# imagen no trae commit, y lo marca como no verificado.

# Desarrollo: loguear el JSON crudo de mensajes no-texto para capturar
# formatos reales de Meta. Apagar en producción.
CAPTURE_PAYLOADS=false

# --- Harness de pruebas en vivo (opcional; SOLO local, jamás en producción) --
# Evolution API que controla una línea tester TUYA para conversar con el bot
# en el canal real (selftest/evolution.py: pausas mínimas, tope de mensajes,
# kill-switch de archivo STOP_LIVE_RUN).
EVOLUTION_BASE_URL=REEMPLAZA_https://tu-evolution.example.com
EVOLUTION_INSTANCE=REEMPLAZA_instancia
EVOLUTION_APIKEY=REEMPLAZA_apikey
# Número al que escribe el tester (único destino permitido)
LIVE_TARGET_NUMBER=REEMPLAZA_52XXXXXXXXXX

# --- Modo cloud: Nea detrás de un Vocero multitenant (opcional) --------------
#
# Vacío = Vocero raíz: el despacho viene firmado con CRM_BOT_API_KEY y Nea
# contesta por /api/bot/*. Es lo de siempre; no toques nada de aquí abajo.
#
# "cloud" = Nea vive detrás de un Vocero multitenant. Cambian dos cosas:
#   - El despacho viene firmado con CRM_BRAIN_SECRET (no con CRM_BOT_API_KEY).
#   - Nea contesta por /api/brains/* con el secreto de la organización.
VOCERO_MODE=

# El secreto. De dónde sale depende de cuántos negocios atienda esta Nea:
#
#   UN negocio  → Ajustes → Cerebro del CRM, opción «mi propio agente».
#   VARIOS      → del despliegue, que registra el dueño de la plataforma con
#                 `pnpm cerebro:registrar` en el CRM. Ningún miembro lo ve.
#
# Firma lo que llega Y autentica lo que sale: el mismo en las dos direcciones.
CRM_BRAIN_SECRET=

# El slug de la organización ({slug}.tudominio.com).
#
# **VACÍO = MULTI-ORGANIZACIÓN.** Esta Nea deja de servir a un negocio y sirve
# a todos los que el CRM le suscriba: cada despacho dice de quién es, y la
# credencial para contestar se deriva del secreto de arriba. Es lo que evita
# levantar un contenedor por miembro.
#
# En ese modo **LLM_API_KEY, LLM_MODEL y LLM_BASE_URL de arriba NO se usan**.
# Cada negocio pone su llave de OpenRouter en su propio CRM, y quien piensa es
# el CRM: Nea le pide por /api/brains/llm y él le pone la credencial de esa
# organización al reenviar al proveedor.
#
# Así la llave del miembro no llega nunca hasta aquí. Es a propósito: una
# llave filtrada no se puede desfiltrar, y si el proveedor la rechaza conviene
# que se entere el CRM, que es quien puede avisarle a su dueño.
#
# Si el CRM no ofrece pensar —este despliegue no es de confianza, o el miembro
# no tiene token activo— Nea se calla y deja la conversación a un humano.
#
# Con un slug puesto, el CRM verifica que el secreto y el slug correspondan,
# así que acertar uno sin el otro no sirve.
CRM_ORGANIZATION=
